# ==============================================================================
# RE:TRACE — Root .gitignore
# ==============================================================================

# ==============================
# Environment & secrets
# ==============================
.env
.env.*
!.env.example
!.env.template

*.pem
*.key
*.crt
*.p12
*.pfx
*.secret
secrets/
credentials/

# ==============================
# Python
# ==============================
__pycache__/
*.py[cod]
*$py.class
*.so

.venv/
venv/
env/
ENV/
.wheelhouse/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ==============================
# Node / Next.js
# ==============================
node_modules/
.next/
out/
dist/
build/
.turbo/
.npm/
.yarn/
.pnpm-store/

npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ==============================
# Frontend local files
# ==============================
*.local

# ==============================
# Solidity / EVM build artifacts
# ==============================
artifacts/
cache/
broadcast/
typechain/
typechain-types/

# ==============================
# Test / coverage artifacts
# ==============================
coverage/
htmlcov/
test-results/
playwright-report/
blob-report/

# ==============================
# Runtime / local application state
# ==============================
backend/data/ledger_state.json
backend/data/uploads/*
!backend/data/uploads/.gitkeep
backend/data/certificates/*
!backend/data/certificates/.gitkeep
*.sqlite
*.sqlite3
*.db

logs/
*.log

# ==============================
# Temporary files
# ==============================
*.tmp
*.temp
*.bak
*.swp
*.swo
Thumbs.db

# ==============================
# IDE / editor
# ==============================
.vscode/
.idea/
*.code-workspace

# ==============================
# Antigravity / agent runtime state
# ==============================
.agents/

# ==============================
# OS metadata
# ==============================
.DS_Store
.AppleDouble
.LSOverride

# ==============================
# Local secrets / credentials
# ==============================
*.token
*.credentials
wallet/
wallets/
